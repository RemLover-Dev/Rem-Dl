# Copy to `.env` and fill in what you need. Everything is optional --
# the same values can be set from the Settings tab in the app UI.
# (`.env` itself is git-ignored; this example file is safe to commit.)

# --- Network ---
USE_PROXY=false
PROXY_URL=http://127.0.0.1:10808
VERIFY_TLS=true
API_TIMEOUT=10
RETRY_WAIT=5
ANTI_BAN_PAUSE=3.0
DOWNLOAD_RETRIES=3

# --- Rule34 ---
RULE34_API_KEY=
RULE34_USER_ID=

# --- Gelbooru ---
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# --- Konachan ---
KONACHAN_USERNAME=
KONACHAN_PASSWORD=

# --- Sankaku ---
SANKA_LOGIN=
SANKA_PASSWORD=

# --- Zerochan ---
ZEROCHAN_LOGIN=
ZEROCHAN_PASSWORD=

# --- Pinterest ---
PINTEREST_COOKIES=
PINTEREST_EMAIL=
PINTEREST_PASSWORD=

# --- Pixiv ---
PIXIV_REFRESH_TOKEN=

# --- X (Twitter) ---
# Optional cookie login instead of password: a path to a cookies.txt
# (Netscape) export, or a raw `auth_token=...; ct0=...` string. Takes
# priority over X_USERNAME/X_PASSWORD when set (still set X_USERNAME so
# the session has an account name).
# Password login: twscrape logs in once and stores the session in
# database/x_accounts.db (login is reused on later runs). If email
# verification is required and IMAP fails, run in a terminal:
#   twscrape --db database/x_accounts.db login_accounts --manual
X_COOKIES=
X_USERNAME=
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=

# --- Headless / Docker only (ignored by the desktop app) ---
# REMS_HEADLESS=1
# PORT=5000
