# Copy to `.env` and fill in what you need. Everything is optional --
# the same values can be set from the Settings tab in the app UI.
# (`.env` itself is git-ignored; this example file is safe to commit.)

# --- Network ---
USE_PROXY=false
PROXY_URL=http://127.0.0.1:10808
VERIFY_TLS=true
API_TIMEOUT=10
RETRY_WAIT=5
ANTI_BAN_PAUSE=3.0
DOWNLOAD_RETRIES=3

# --- Download behaviour ---
# requests per second per host (the pacing gate re-reads this live)
REQ_RATE_LIMIT=4
# perceptual-hash + source-hash duplicates: download once, keep the larger copy
DEDUP_ENABLED=true
# convert downloaded JPEG XL to PNG/JPEG on disk; EFFORT is 1-9 (higher = smaller)
AUTO_CONVERT_JXL=false
JXL_EFFORT=5

# --- Rule34 ---
RULE34_API_KEY=
RULE34_USER_ID=

# --- Gelbooru ---
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# --- Gsbooru ---
GSBOORU_API_KEY=

# --- Konachan ---
KONACHAN_USERNAME=
KONACHAN_PASSWORD=

# --- Danbooru ---
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# --- Sankaku ---
SANKA_LOGIN=
SANKA_PASSWORD=
# optional: a pre-obtained API access token instead of login/password
SANKA_ACCESS_TOKEN=

# --- Zerochan ---
ZEROCHAN_LOGIN=
ZEROCHAN_PASSWORD=

# --- Pixiv ---
PIXIV_REFRESH_TOKEN=
# alternative to the token: `PHPSESSID=...` or the `code` from the OAuth callback
PIXIV_COOKIE=

# --- X (Twitter) ---
# Cookie login only: a path to a cookies.txt (Netscape) export, or a raw
# `auth_token=...; ct0=...` string. X_USERNAME must name the account those
# cookies belong to (twscrape needs it to build the session).
X_COOKIES=
X_USERNAME=

# --- Headless / Docker only (ignored by the desktop app) ---
# REMS_HEADLESS=1
# PORT=5000
# A non-loopback bind (REMS_HOST) is refused without a 32+ character
# REMS_ACCESS_TOKEN and an explicit REMS_ALLOWED_HOSTS allowlist.
# REMS_HOST=0.0.0.0
# REMS_ACCESS_TOKEN=
# REMS_ALLOWED_HOSTS=localhost,127.0.0.1
# Serve under a URL subpath behind a reverse proxy that strips the prefix
# (nginx: location /remdl/ { proxy_pass http://app:5000/; }). Empty = root.
# REMS_BASE_PATH=/remdl
